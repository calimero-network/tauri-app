{
  "name": "desktop",
  "version": "0.0.65",
  "description": "Calimero Desktop Application",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "merod:prepare": "node scripts/prepare-merod.mjs",
    "tauri": "tauri",
    "tauri:dev": "pnpm merod:prepare && tauri dev --config src-tauri/tauri.dev.json",
    "tauri:dev:devtools": "pnpm merod:prepare && TAURI_OPEN_DEVTOOLS=true tauri dev --config src-tauri/tauri.dev.json",
    "tauri:dev:no-devtools": "pnpm merod:prepare && TAURI_OPEN_DEVTOOLS=false tauri dev --config src-tauri/tauri.dev.json",
    "tauri:build": "pnpm merod:prepare && tauri build --bundles app",
    "tauri:build:app": "pnpm merod:prepare && tauri build --bundles app",
    "tauri:build:full": "pnpm merod:prepare && tauri build",
    "icon": "node scripts/svg-to-icon.js && pnpm tauri icon src-tauri/icons/icon-1024.png",
    "clean": "rm -rf dist src-tauri/target",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@calimero-network/mero-js": "^2.2.1",
    "@calimero-network/mero-react": "^2.4.0",
    "@tauri-apps/api": "^1.5.0",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "ansi-to-html": "^0.7.2",
    "bs58": "^6.0.0",
    "lucide-react": "^0.563.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tauri-apps/cli": "1.5.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^3.1.0",
    "sharp": "^0.34.5",
    "tar": "^7.5.16",
    "typescript": "^5.8.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  }
}
