<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>network.calimero.desktop</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>calimero</string>
			</array>
		</dict>
	</array>
	<!-- Required so the embedded WKWebView may access camera/microphone for
	     WebRTC video calls (Mero Meet). Without these usage strings macOS
	     terminates the app on the first getUserMedia() call. -->
	<key>NSCameraUsageDescription</key>
	<string>Calimero needs camera access for video calls in apps like Mero Meet.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Calimero needs microphone access for audio in calls in apps like Mero Meet.</string>
</dict>
</plist>
