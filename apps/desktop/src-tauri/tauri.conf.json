{
  "build": {
    "beforeDevCommand": "pnpm merod:prepare && pnpm dev",
    "beforeBuildCommand": "pnpm merod:prepare && pnpm shell:prepare && pnpm build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "entitlements": "entitlements.plist",
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null,
      "minimumSystemVersion": "10.15"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "merod",
      "shell/calimero-shell",
      "shell/launcher-trampoline"
    ],
    "createUpdaterArtifacts": "v1Compatible"
  },
  "productName": "Calimero Desktop",
  "mainBinaryName": "Calimero Desktop",
  "version": "0.0.90",
  "identifier": "network.calimero.desktop",
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/calimero-network/tauri-app/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ5MjQxOUM0QzJCODQ3MUEKUldRYVI3akN4QmtrMlNZRDVQMVJ4bTFvTW1JSHgycjhDNlhzZ3NOQXpHWHByOHMyZ2ZIU2RoOFYK"
    },
    "deep-link": {
      "desktop": {
        "schemes": ["calimero"]
      }
    }
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "dangerousDisableAssetCspModification": true,
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' http://localhost:* http://127.0.0.1:* https://api.github.com; connect-src ipc: http://ipc.localhost https://ipc.localhost 'self' https://apps.calimero.network https://*.calimero.network http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:* wss://* https: http: ws: wss: https://api.github.com https://github.com; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: http:; font-src 'self' data:; frame-src 'self' https: http:;"
    },
    "windows": [
      {
        "label": "main",
        "fullscreen": false,
        "resizable": true,
        "title": "Calimero Desktop",
        "width": 1200,
        "height": 800,
        "minWidth": 1200,
        "minHeight": 800,
        "useHttpsScheme": true
      }
    ]
  }
}