{
  "name": "calimero-desktop-platforms",
  "version": "0.1.0",
  "description": "Monorepo for Calimero desktop applications",
  "minimumAppVersion": "0.0.82",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:desktop": "pnpm --filter desktop tauri:dev",
    "dev:desktop:devtools": "pnpm --filter desktop tauri:dev:devtools",
    "dev:desktop:no-devtools": "pnpm --filter desktop tauri:dev:no-devtools",
    "build:desktop": "pnpm --filter desktop tauri:build",
    "tauri:desktop": "pnpm --filter desktop tauri",
    "dev:download-site": "pnpm --filter download-site dev",
    "build:download-site": "pnpm --filter download-site build",
    "build:mero-react": "pnpm --filter @calimero-network/mero-react build",
    "dev": "pnpm build:mero-react && pnpm dev:desktop",
    "build": "pnpm build:mero-react && pnpm build:desktop",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "check-runners": "ps aux | grep merod",
    "test:e2e:desktop": "pnpm --filter desktop test:e2e"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.18"
    }
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
